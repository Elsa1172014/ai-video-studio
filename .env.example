# Preferred: Runpod Serverless
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Where Runpod outputs are publicly served (object storage / file server exposing /outputs/<file>)
PUBLIC_OUTPUT_BASE_URL=

# HTTP GPU worker (also serves /outputs, /media uploads and cinematic finishing)
GPU_API_URL=
GPU_API_KEY=

# Free cloud (no server): GitHub Actions + Hugging Face ZeroGPU. Used when no Runpod/HTTP worker is set,
# or forced with STUDIO_BACKEND=cloud. See docs/FREE_CLOUD.md.
GITHUB_CLOUD_REPO=
GITHUB_CLOUD_TOKEN=
# STUDIO_BACKEND=cloud
