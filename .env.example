# ---------- GPU (one of) ----------
# Preferred: RunPod Serverless (worker/Dockerfile.runpod)
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Legacy HTTP GPU worker fallback (worker/main.py)
GPU_API_URL=
GPU_API_KEY=
# Video adapter used for production shots (ltx | wan) and longest single shot in seconds
VIDEO_PROVIDER=wan
MAX_SHOT_SECONDS=5
# TTS: provider label and fallback narrator voice id passed to the worker's TTS_GENERATE_COMMAND
TTS_PROVIDER=tts
DEFAULT_VOICE_ID=default

# ---------- Database ----------
# PostgreSQL (Neon / Vercel Postgres / Supabase). The table is created automatically
# (see db/schema.sql). Without it a JSON file in DATA_DIR (.data/) is used: dev only, NOT durable on Vercel.
DATABASE_URL=

# ---------- Media storage (one of) ----------
# Vercel Blob (recommended on Vercel)
BLOB_READ_WRITE_TOKEN=
# or any S3-compatible store (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Use the SAME values on the GPU worker so generated clips are uploaded there directly.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
# Extra hosts the server may download generated media from (comma separated)
MEDIA_ALLOWED_HOSTS=
# Public URL of this app, only needed when media is on the local dev store and the GPU must fetch it
PUBLIC_APP_URL=

# ---------- AI director (optional) ----------
# Enables Claude-based scene planning and episode-memory drafting; deterministic planner otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Access ----------
# There are no user accounts: everyone who can open the app shares all projects.
# Set a password to require HTTP Basic auth on every page and API route.
STUDIO_PASSWORD=

# Job timeouts in minutes (defaults: video 30, audio 10, render 30)
JOB_TIMEOUT_VIDEO_MINUTES=
JOB_TIMEOUT_AUDIO_MINUTES=
JOB_TIMEOUT_RENDER_MINUTES=

# Vast.ai HTTP worker (select explicitly so old RunPod credentials do not win)
GPU_PROVIDER=vast
# Set GPU_API_URL to the worker's HTTPS origin; keep GPU_API_KEY server-side.
# Wan 2.2 TI2V-5B worker defaults (no custom shell command needed)
WAN_DIR=/opt/Wan2.2
WAN_CKPT_DIR=/models/Wan2.2-TI2V-5B
WAN_TIMEOUT_SECONDS=1800
# Worker only: keyless preview narration (Microsoft Edge online service; not voice cloning)
TTS_ENGINE=edge
TTS_TIMEOUT_SECONDS=120
