GPU_API_KEY=change-me
PUBLIC_OUTPUT_BASE_URL=https://your-gpu-worker.example.com
# On Lightning, point these at persistent Studio storage rather than /tmp.
OUTPUT_DIR=/teamspace/studios/this_studio/ai-video-output
JOB_DIR=/teamspace/studios/this_studio/ai-video-output/jobs
LTX_DIR=/teamspace/studios/this_studio/LTX-Video
LTX_PIPELINE_CONFIG=configs/ltxv-2b-0.9.6-distilled.yaml
WAN_GENERATE_COMMAND=
# Text-to-speech engine command. Receives TTS_TEXT, TTS_LANGUAGE, TTS_VOICE and must write TTS_OUTPUT (wav).
TTS_GENERATE_COMMAND=
# Optional: upload outputs to S3-compatible storage (same values as the web app) so they get durable public URLs
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
# Hosts allowed even if they resolve to private addresses (e.g. a LAN media server)
MEDIA_ALLOWED_HOSTS=
