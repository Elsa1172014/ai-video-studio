GPU_API_KEY=change-me
PUBLIC_OUTPUT_BASE_URL=https://your-gpu-worker.example.com
# Commands are intentionally configurable so the worker can call the installed official model runtime.
# They receive VIDEO_PROMPT, VIDEO_DURATION, VIDEO_OUTPUT and VIDEO_IMAGE_URL environment variables.
WAN_GENERATE_COMMAND=
LTX_GENERATE_COMMAND=
OUTPUT_DIR=/tmp/ai-video-output
