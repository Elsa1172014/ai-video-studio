FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True LTX_DIR=/opt/LTX-Video OUTPUT_DIR=/runpod-volume/outputs JOB_DIR=/runpod-volume/jobs
RUN apt-get update && apt-get install -y --no-install-recommends git python3 python3-pip ffmpeg curl ca-certificates fontconfig \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone --depth 1 https://github.com/Lightricks/LTX-Video.git
# LTX uses a Poetry build backend that does not support editable installs in this image.
# Install the inference extras as a normal package, matching the upstream instructions.
RUN python3 -m pip install --no-cache-dir "/opt/LTX-Video[inference]" && python3 -m pip install --no-cache-dir runpod fastapi uvicorn python-multipart imageio-ffmpeg
# Kinocut in its own environment: it needs Python >=3.11 (this image ships 3.10); uv fetches 3.11.
RUN python3 -m pip install --no-cache-dir uv && UV_TOOL_BIN_DIR=/usr/local/bin uv tool install --python 3.11 "kinocut>=1.16.4" && kino --version
# HyperFrames (HeyGen) for animated Arabic title/end cards. Cards fall back to FFmpeg if Chrome is unavailable.
RUN npm install -g hyperframes@latest && (hyperframes browser ensure || echo "HyperFrames browser unavailable: cards fall back to FFmpeg")
WORKDIR /app
COPY worker/ /app/
RUN mkdir -p /usr/share/fonts/truetype/cairo && cp /app/assets/fonts/*.ttf /usr/share/fonts/truetype/cairo/ && fc-cache -f
CMD ["python3","-u","runpod_handler.py"]
